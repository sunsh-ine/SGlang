  "cards": [
    {
      "dot": "cyan",
      "title": "主路径与进程拓扑",
      "items": [
        "请求链路：调用方 → HTTP Server → TokenizerManager → Scheduler → TpModelWorker → KV Cache",
        "HTTP Server、Engine、TokenizerManager 同在主进程；Scheduler 与 DetokenizerManager 各为独立子进程",
        "主进程与子进程之间用 ZMQ PUSH/PULL；返回链路为 Scheduler → DetokenizerManager → TokenizerManager → SSE"
      ]
    },
    {
      "dot": "emerald",
      "title": "KV 与前缀复用",
      "items": [
        "KV 常驻显存池：prefill 写入、decode 读取并追加，块索引由分页分配器管理",
        "UnifiedRadixCache 按最长前缀命中复用已算 KV，逐出时把块归还分配器",
        "decode/prefill 走 CUDA Graph 重放；EAGLE 投机解码与 PD 分离是可选路径"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖与信任边界",
      "items": [
        "权重来自 HuggingFace Hub 或 ModelScope，运行时容器固化 CUDA + PyTorch + NCCL",
        "--api-key / --admin-api-key 走 Bearer 常量时间校验，/health 与 /metrics 始终免鉴权",
        "可选入口 sgl-model-gateway（Rust）负责负载均衡与服务发现，本图未展开"
      ]
    }
  ]
