    },
    {
      "participant": "sched",
      "from": 222,
      "to": 330,
      "type": "backend"
    },
    {
      "participant": "worker",
      "from": 256,
      "to": 296,
      "type": "cloud"
    },
    {
      "participant": "detok",
      "from": 316,
      "to": 360,
      "type": "backend"
    },
    {
      "participant": "tokenizer",
      "from": 350,
      "to": 392,
      "type": "backend"
    },
    {
      "participant": "http",
      "from": 378,
      "to": 430,
      "type": "frontend"
    },
    {
      "participant": "tokenizer",
      "from": 472,
      "to": 492,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "为什么中间还有 Detokenizer",
      "items": [
        "Scheduler 只产出 token ids",
        "Detokenizer 只转新增 token（read_offsets）",
        "TokenizerManager 持有请求状态与连接"
      ]
    },
    {
      "dot": "emerald",
      "title": "谁最终回给客户端",
      "items": [
        "BatchStrOutput → ReqState.out_queue",
        "HTTP 分片 → StreamingResponse（SSE）",
        "非 stream 请求一次性返回结果"
      ]
    },
    {
      "dot": "amber",
      "title": "两条通道别混淆",
      "items": [
        "生成结果：Scheduler → Detokenizer → Tokenizer",
        "控制类：Scheduler 直连 Tokenizer",
        "例外：skip_tokenizer_init / Rust server"
      ]
    }
  ]
}
