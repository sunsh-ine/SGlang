  "cards": [
    {
      "dot": "cyan",
      "title": "进什么 / 出什么",
      "items": [
        "进：rids、decode_ids、read_offsets",
        "出：BatchStrOutput（文本 + ids/usage）",
        "routed_experts → base64；embedding 结果不解码、直接透传"
      ]
    },
    {
      "dot": "emerald",
      "title": "增量解码怎么只发新增",
      "items": [
        "decode_status 存 decode_ids 与三个偏移",
        "read 与 surr 两次 decode 取差 = 新增文本",
        "finished 时删缓存并按 stop 词裁剪尾段"
      ]
    },
    {
      "dot": "amber",
      "title": "交互方向判定",
      "items": [
        "Scheduler → Detokenizer：单向，无回包",
        "Detokenizer → TokenizerManager：单向",
        "↔ decode_status：进程内双向读写",
        "PUSH/PULL 无 ack：下游慢只积压，不回压"
      ]
    }
  ]
