  "edges": [
    {
      "id": "in",
      "from": "req_in",
      "to": "state",
      "label": "GenerateReqInput",
      "role": "main"
    },
    {
      "id": "init",
      "from": "state",
      "to": "tokenize",
      "label": "过 pause / 读锁",
      "role": "main"
    },
    {
      "id": "tok",
      "from": "tokenize",
      "to": "dispatch",
      "label": "input_ids",
      "role": "main"
    },
    {
      "id": "push",
      "from": "dispatch",
      "to": "sched",
      "label": "ZMQ 下发",
      "role": "main"
    },
    {
      "id": "to-detok",
      "from": "sched",
      "to": "detok",
      "label": "BatchTokenIDOutput",
      "role": "main"
    },
    {
      "id": "back",
      "from": "detok",
      "to": "recv",
      "label": "BatchStrOutput",
      "role": "return"
    },
    {
      "id": "drain",
      "from": "recv",
      "to": "stream",
      "label": "写 out_list",
      "role": "main"
    },
    {
      "id": "yield",
      "from": "stream",
      "to": "sse",
      "label": "分片 yield",
      "role": "main"
    },
    {
      "id": "abort",
      "from": "stream",
      "to": "dispatch",
      "label": "断连 → AbortReq",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "进来后先做什么",
      "items": [
        "normalize + 默认优先级，建 ReqState 并登记到 rid_to_state",
        "过 pause 门与权重更新读锁，避免 LoRA / 权重切换期间误用",
        "_tokenize_one_request 分词并做长度校验，组出 TokenizedGenerateReqInput"
      ]
    },
    {
      "dot": "emerald",
      "title": "下发与回程怎么接",
      "items": [
        "_send_one_request → ZMQ PUSH 给 Scheduler（单向下发，不等回包）",
        "handle_loop 异步收 BatchStrOutput，按 rid 找到 state 写 out_list + event",
        "等待循环 drain out_list 逐个 yield 分片；finish 后删掉 rid_to_state"
      ]
    },
    {
      "dot": "amber",
      "title": "边界与例外",
      "items": [
        "断连：等待循环里 request.is_disconnected() → abort_request → AbortReq 回 Scheduler",
        "非流式：等 finished 一次性返回；增量流式会合并已排队分片",
        "多 tokenizer worker：MultiTokenizerRouter 前置，按 http_worker_ipc 推回对应进程"
      ]
    }
  ]
}
